---
import { featuredProjects } from "../data/projects";
---

<section class="px-6 md:px-12 lg:px-24 max-w-6xl mx-auto py-24">
  <div class="flex items-center gap-4 mb-16 reveal">
    <span class="section-label">Featured Work</span>
    <div class="flex-1 h-px bg-border"></div>
  </div>

  <div class="grid grid-cols-1 gap-10">
    {featuredProjects.map((project, i) => (
      <article class="reveal">
        <div class="gradient-border relative z-10 overflow-hidden transition-transform duration-500 hover:translate-y-[-4px]">
          {/* Loom video embed for projects that have one */}
          {project.loom && (
            <div class="relative w-full aspect-video bg-base-dim">
              <iframe
                src={project.loom + "?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true"}
                frameborder="0"
                allowfullscreen
                loading="lazy"
                class="absolute inset-0 w-full h-full"
              ></iframe>
            </div>
          )}

          {/* Inline performance chart for Calhacks (no loom) */}
          {!project.loom && i === 1 && (
            <div class="px-8 pt-8 md:px-10 md:pt-10">
              <div class="bg-base-dim/50 rounded-lg p-5 md:p-6">
                <div class="flex items-end gap-4 h-28">
                  {/* Before bar */}
                  <div class="flex flex-col items-center gap-2 flex-1">
                    <span class="text-xs text-text-subtle font-medium">62s</span>
                    <div class="w-full bg-text-subtle/20 rounded-t-md h-full"></div>
                    <span class="text-xs text-text-subtle">Before</span>
                  </div>
                  {/* Arrow */}
                  <div class="flex items-center pb-6">
                    <svg class="w-6 h-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </div>
                  {/* After bar */}
                  <div class="flex flex-col items-center gap-2 flex-1">
                    <span class="text-xs text-accent font-semibold">39ms</span>
                    <div class="w-full bg-accent/60 rounded-t-md" style="height: 2%;"></div>
                    <div class="flex-1"></div>
                    <span class="text-xs text-text-subtle">After</span>
                  </div>
                </div>
                <p class="text-xs text-text-subtle text-center mt-3">245M rows &middot; 20GB dataset &middot; 1,600x faster</p>
              </div>
            </div>
          )}

          {/* Text content */}
          <div class="relative z-10 p-8 md:p-10 space-y-4">
            {/* Award badge */}
            {project.award && (
              <span class="inline-flex items-center gap-1.5 text-xs font-medium tracking-wide uppercase text-accent bg-accent/8 px-3 py-1.5 rounded-full">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                {project.award}
              </span>
            )}

            {/* Title + link */}
            <div>
              {project.link ? (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2.5 group/link"
                >
                  <h3 class="text-fluid-heading font-semibold text-text group-hover/link:text-accent transition-colors duration-300">
                    {project.title}
                  </h3>
                  <svg class="w-5 h-5 text-text-subtle opacity-0 -translate-x-2 translate-y-1 group-hover/link:opacity-100 group-hover/link:translate-x-0 group-hover/link:translate-y-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                </a>
              ) : (
                <h3 class="text-fluid-heading font-semibold text-text">
                  {project.title}
                </h3>
              )}
              <p class="text-text-subtle text-sm mt-1">{project.subtitle}</p>
            </div>

            {/* Description */}
            <p class="text-fluid-body text-text-muted max-w-2xl">
              {project.description}
            </p>

            {/* Tags */}
            <div class="flex flex-wrap gap-2 pt-1">
              {project.tags.map((tag) => (
                <span class="text-xs font-medium text-text-subtle bg-base-dim/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-border/30">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
