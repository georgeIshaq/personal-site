---
import { experiences } from "../data/experience";
---

<section class="px-6 md:px-12 lg:px-24 max-w-6xl mx-auto py-24">
  <div class="flex items-center gap-4 mb-16 reveal">
    <span class="section-label">Experience</span>
    <div class="flex-1 h-px bg-border"></div>
  </div>

  <div class="relative pl-8 md:pl-0">
    <!-- Timeline line (mobile) -->
    <div class="timeline-line md:hidden" aria-hidden="true"></div>

    <div class="space-y-14">
      {experiences.map((exp, i) => (
        <article class="relative grid grid-cols-1 md:grid-cols-[180px_1fr] gap-4 md:gap-16 reveal">
          <!-- Timeline dot (mobile) -->
          <div class="timeline-dot md:hidden" aria-hidden="true"></div>

          <!-- Left: meta -->
          <div class="text-sm shrink-0 md:text-right md:pt-1">
            <span class="block font-medium text-text">{exp.period}</span>
            <span class="block text-text-subtle mt-0.5">{exp.location}</span>
          </div>

          <!-- Right: content -->
          <div class="relative md:pl-10 md:border-l md:border-border">
            <!-- Timeline dot (desktop) -->
            <div class="hidden md:block absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full bg-accent shadow-[0_0_0_3px_var(--color-base)]" aria-hidden="true"></div>

            <h3 class="text-lg font-semibold text-text">{exp.company}</h3>
            <p class="text-text-muted text-sm mb-4">{exp.role}</p>
            <ul class="space-y-2.5">
              {exp.bullets.map((bullet) => (
                <li class="text-fluid-body text-text-muted pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[0.65em] before:w-1.5 before:h-1.5 before:rounded-full before:bg-accent/30">
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
