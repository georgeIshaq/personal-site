---
import { awards } from "../data/projects";
---

<section class="px-6 md:px-12 lg:px-24 max-w-6xl mx-auto py-24">
  <div class="flex items-center gap-4 mb-16 reveal">
    <span class="section-label">Awards</span>
    <div class="flex-1 h-px bg-border"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 stagger">
    {awards.map((award, i) => (
      <article class={`bento-card ${i === 0 ? 'bento-accent' : i === 2 ? 'bento-highlight' : ''}`}>
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span class="text-xs font-medium text-text-subtle uppercase tracking-wider">{award.year}</span>
        </div>
        <h3 class="text-lg font-semibold text-text">{award.title}</h3>
        <p class="text-sm text-text-muted mt-1.5">{award.event}</p>
        <p class="text-sm text-accent mt-3 font-semibold">{award.placement}</p>
      </article>
    ))}
  </div>
</section>
