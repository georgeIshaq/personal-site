---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<Layout>
  <div class="scroll-progress" aria-hidden="true"></div>

  <main class="px-5 md:px-10 lg:px-16 max-w-5xl mx-auto pb-8">

    {/* ─── HEADER ─── */}
    <header class="relative pt-14 md:pt-20 pb-14">
      <div class="float-shape float-shape-1 w-72 h-72 bg-accent/10 -top-24 -right-24" aria-hidden="true"></div>
      <div class="float-shape float-shape-2 w-48 h-48 bg-highlight/8 top-1/3 -right-12" aria-hidden="true"></div>

      <div class="relative z-10">
        <div class="flex items-start justify-between gap-4">
          <h1 class="hero-name text-fluid-display tracking-tight text-text">
            George Ishaq
          </h1>
          <ThemeToggle />
        </div>

        {/* Thin rule — lets the name breathe before the context */}
        <div class="h-px bg-border mt-5 mb-5 max-w-xs"></div>

        <p class="text-lg md:text-xl text-text-muted leading-relaxed">
          Currently at
          <a href="https://legionhealth.com" target="_blank" rel="noopener noreferrer" class="text-text font-semibold hover:text-accent transition-colors whitespace-nowrap"><img src="/logos/legion-health-heart.svg" alt="" class="inline h-[1.1em] relative -top-px mr-1" aria-hidden="true" />Legion Health</a>.
          Incoming member of technical staff at
          <a href="https://www.applovin.com" target="_blank" rel="noopener noreferrer" class="text-text font-semibold hover:text-accent transition-colors whitespace-nowrap"><img src="/logos/applovin.svg" alt="" class="inline h-[1.1em] relative -top-px mr-1" aria-hidden="true" />AppLovin</a>.
        </p>
        <p class="text-lg md:text-xl text-text-muted leading-relaxed mt-1">
          Interested in technical AI safety and mechanistic interpretability.
        </p>

        <div class="flex items-center gap-3 mt-5">
          <a href="https://github.com/georgeIshaq" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-accent transition-colors" aria-label="GitHub">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://linkedin.com/in/georgeishaq" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-accent transition-colors" aria-label="LinkedIn">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="mailto:ishaq@uni.minerva.edu" class="text-text-subtle hover:text-accent transition-colors" aria-label="Email">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>
      </div>
    </header>

    {/* ─── WORK ─── */}
    <section class="pb-16">
      <div class="flex items-center gap-4 mb-10">
        <span class="section-label">Work</span>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      {/* ── Spark — flagship, gets the most visual weight ── */}
      <div class="gradient-border mb-10">
        {/* Screenshots — chat interface dominates, homepage secondary */}
        <div class="p-3 md:p-4 pb-0 md:pb-0">
          <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-2.5">
            <img
              src="/spark_chat_screen_with_game_preview.png"
              alt="Spark — AI chat generating a game with live preview"
              class="w-full h-full object-cover rounded-lg shadow-sm"
              loading="lazy"
            />
            <img
              src="/spark_home_page.png"
              alt="Spark — home page"
              class="w-full h-full object-cover rounded-lg shadow-sm hidden md:block"
              loading="lazy"
            />
          </div>
        </div>
        <div class="relative z-10 p-6 md:px-8 md:py-7">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium tracking-wide uppercase text-accent bg-accent/8 px-2.5 py-1 rounded-full mb-3">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            YC AI Hackathon Winner &middot; Minerva Capstone
          </span>
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
            <div>
              <a href="https://splarve.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 group/link">
                <h2 class="text-fluid-heading font-semibold text-text group-hover/link:text-accent transition-colors">Spark</h2>
                <svg class="w-4 h-4 text-text-subtle opacity-0 -translate-x-1 group-hover/link:opacity-100 group-hover/link:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </a>
              <p class="text-fluid-body text-text-muted mt-2 max-w-xl">
                AI game creation platform. I built the agentic code generation — the system that turns natural language prompts into playable games with live preview.
              </p>
              <p class="text-sm text-text-subtle mt-3">TypeScript, Next.js, Claude AI</p>
            </div>
            <a
              href="https://www.loom.com/share/3d13038095c94d01afb2892b81608933"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-text bg-accent/8 hover:bg-accent/15 px-4 py-2 rounded-lg transition-colors shrink-0"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Watch demo
            </a>
          </div>
        </div>
      </div>

      {/* ── AppLovin — compact, chart gives it identity ── */}
      <div class="gradient-border">
        <div class="relative z-10 p-6 md:px-8 md:py-7">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium tracking-wide uppercase text-accent bg-accent/8 px-2.5 py-1 rounded-full mb-3">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Cal Hacks x AppLovin
          </span>
          <div class="flex flex-col md:flex-row gap-6 md:gap-10">
            <div class="flex-1">
              <a href="https://github.com/georgeIshaq/Calhacks_AppLovin_Challenge" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 group/link">
                <h2 class="text-fluid-heading font-semibold text-text group-hover/link:text-accent transition-colors">AppLovin Data Challenge</h2>
                <svg class="w-4 h-4 text-text-subtle opacity-0 -translate-x-1 group-hover/link:opacity-100 group-hover/link:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </a>
              <p class="text-fluid-body text-text-muted mt-2 max-w-xl">
                Optimized queries on a 245M-row, 20GB dataset from 62 seconds to 39 milliseconds using pre-aggregated rollup tables and an intelligent query router.
              </p>
              <p class="text-sm text-text-subtle mt-3">Python, Polars, DuckDB, Arrow IPC</p>
            </div>
            {/* Performance chart — right side on desktop */}
            <div class="bg-base-dim/50 rounded-lg p-4 flex items-end gap-6 h-28 w-full md:w-44 shrink-0">
              <div class="flex flex-col items-center gap-1 h-full justify-end flex-1">
                <span class="text-[0.65rem] font-bold text-text-subtle">62s</span>
                <div class="w-full compress-bar bg-text-subtle/25 flex-1 max-h-[85%]"></div>
              </div>
              <div class="flex flex-col items-center gap-1 h-full justify-end flex-1">
                <span class="text-[0.65rem] font-bold text-accent">39ms</span>
                <div class="w-full bg-accent/70 rounded-t" style="height: 2px;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ─── EXPERIENCE ─── */}
    <section class="pb-12">
      <div class="flex items-center gap-4 mb-6">
        <span class="section-label">Experience</span>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      <div class="space-y-3.5">
        <div class="grid grid-cols-[140px_1fr] md:grid-cols-[180px_1fr] gap-x-4 items-baseline">
          <span class="text-sm font-medium text-text">Legion Health <span class="text-accent text-xs font-semibold">(YC)</span></span>
          <span class="text-sm text-text-muted">Software Engineer — present</span>
        </div>
        <div class="grid grid-cols-[140px_1fr] md:grid-cols-[180px_1fr] gap-x-4 items-baseline">
          <span class="text-sm font-medium text-text">Stealth Startup</span>
          <span class="text-sm text-text-muted">Built realtime messaging + payments for a mobile C2C marketplace</span>
        </div>
        <div class="grid grid-cols-[140px_1fr] md:grid-cols-[180px_1fr] gap-x-4 items-baseline">
          <span class="text-sm font-medium text-text">Hawsib</span>
          <span class="text-sm text-text-muted">Built hit.ps e-commerce platform, 100K+ visits</span>
        </div>
        <div class="grid grid-cols-[140px_1fr] md:grid-cols-[180px_1fr] gap-x-4 items-baseline">
          <span class="text-sm font-medium text-text">Minerva University</span>
          <span class="text-sm text-text-muted">Taught Python fundamentals to 200+ freshmen</span>
        </div>
      </div>
    </section>

    {/* ─── AWARDS — visually distinct from experience ─── */}
    <section class="pb-12">
      <div class="flex items-center gap-4 mb-6">
        <span class="section-label">Awards</span>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      <div class="space-y-3.5">
        <div class="grid grid-cols-[140px_1fr] md:grid-cols-[180px_1fr] gap-x-4 items-baseline">
          <span class="text-sm font-medium text-text">RainForce</span>
          <span class="text-sm text-text-muted"><span class="text-highlight font-semibold">1st place</span> &middot; Agents in The Loop Hackathon '25</span>
        </div>
        <div class="grid grid-cols-[140px_1fr] md:grid-cols-[180px_1fr] gap-x-4 items-baseline">
          <span class="text-sm font-medium text-text">Medibot</span>
          <span class="text-sm text-text-muted"><span class="text-highlight font-semibold">3rd place</span> &middot; Stanford TreeHacks '23</span>
        </div>
      </div>
    </section>

    {/* ─── ABOUT ─── */}
    <section class="pb-14">
      <p class="text-fluid-body text-text-muted max-w-2xl">
        CS senior at Minerva University in San Francisco, graduating 2026.
        Currently studying technical AI safety — mechanistic interpretability, RLHF, and alignment.
      </p>
    </section>

    {/* ─── CONTACT ─── */}
    <section class="pb-6">
      <div class="flex flex-wrap items-center gap-5 text-sm">
        <a href="mailto:ishaq@uni.minerva.edu" class="text-text font-medium link-underline">ishaq@uni.minerva.edu</a>
        <a href="https://github.com/georgeIshaq" target="_blank" rel="noopener noreferrer" class="text-text-muted link-underline">GitHub</a>
        <a href="https://linkedin.com/in/georgeishaq" target="_blank" rel="noopener noreferrer" class="text-text-muted link-underline">LinkedIn</a>
      </div>
      <p class="text-xs text-text-subtle mt-6">George Ishaq &mdash; {new Date().getFullYear()}</p>
    </section>
  </main>
</Layout>
